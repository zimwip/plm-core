# ============================================================
# PLM Core - Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# NE PAS committer .env en production
# ============================================================

# PostgreSQL — required, no default
# Generate: openssl rand -base64 32
PG_PASSWORD=

# Inter-service shared secret — required, no default.
# Used as HMAC-SHA256 key for JWT signing (spe-api mints, psm/pno verify)
# AND as X-Service-Secret for registry calls and pno /users/{id}/context.
# MUST be >= 32 bytes (HS256 requirement).
# Generate: openssl rand -base64 32
PLM_SERVICE_SECRET=

# Optionnel : port applicatif (défaut 8080)
# PLM_PORT=8080

# ============================================================
# Garage — S3-compatible object store (dst blob storage)
# ============================================================
# Cluster RPC secret + admin API token — required.
# Generate each: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# S3 credentials dst uses to sign requests. Fixed (imported at bootstrap).
# Access key MUST start with "GK" — generate: echo GK$(openssl rand -hex 12)
# Secret — generate: openssl rand -hex 32
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=

# Bucket dst writes blobs to.
GARAGE_S3_BUCKET=plm-dst

# ============================================================
# cad-parser — OCCT tessellation quality
# ============================================================
# Controls mesh density for STEP → GLB conversion.
# BRepRelative: deflection is a fraction of each shape's bounding box.
#   0.1 = 10% of bbox (good for visualization, fast)
#   0.05 = 5% (higher quality, slower)
#   0.2 = 20% (coarser, faster)
# Lower angularDeflection = smoother curved surfaces (more triangles).
OCCT_LINEAR_DEFLECTION=0.05
OCCT_ANGULAR_DEFLECTION=0.3
OCCT_DEFLECTION_TYPE=BRepRelative
